# Cypress E2E test environment.
# Copy this file to apps/app/.env.test and fill in values from your test Supabase project.
# IMPORTANT: never reuse your dev Supabase project — tests create and delete real users.

# Public app env (also used by the app server during e2e runs)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgres://user:password@localhost:5432/mirrorverse_e2e

# Cypress-only — server-side admin client used by cy.task('generateOtp') etc.
# This is the service_role key; treat as a secret.
E2E_SUPABASE_URL=
E2E_SUPABASE_SERVICE_ROLE_KEY=

# Optional override; defaults to http://localhost:3000
# CYPRESS_BASE_URL=http://localhost:3000
