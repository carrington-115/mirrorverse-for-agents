# Application
NODE_ENV=development
PORT=3001
API_VERSION=v1

# Database
DATABASE_URL=postgres://user:password@localhost:5432/mirrorverse

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Authentication
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# AI Services
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Messaging
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Monitoring
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# Inngest
# Set INNGEST_DEV=1 for local development; without it the serve endpoint
# returns 500 ("In cloud mode but no signing key found"). Leave the keys
# blank in dev — they're only needed in production.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_SIGNING_KEY_FALLBACK=

# CORS
CORS_ORIGIN=http://localhost:3000
