# Application
NODE_ENV=development
PORT=3001
API_VERSION=v1

# Database
# Privileged connection (service role) — used for migrations, the workspace
# bootstrap, and `withServiceRole`. Bypasses Row-Level Security.
DATABASE_URL=postgres://user:password@localhost:5432/mirrorverse
# Runtime connection for the non-privileged `app_user` role that RLS policies
# are enforced against. Leave blank locally to fall back to DATABASE_URL (RLS
# inert). In staging/production point this at the app_user DSN.
RUNTIME_DATABASE_URL=postgres://app_user:password@localhost:5432/mirrorverse

# Redis (Upstash REST API — used for billing quota counters)
# Create a database at https://console.upstash.com, then copy both values
# from its "REST API" section. Optional: omit to fall back to an in-memory
# (per-instance, non-persistent) quota counter in dev.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Authentication
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# AI Services
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ELEVENLABS_API_KEY=
E2B_API_KEY=e2b_...

# Messaging
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Monitoring
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# Backend public URL (used as the Vapi webhook base URL).
# In dev: run `pnpm --filter @mirrorverse/backend dev:tunnel`, copy the printed
# URL, paste it here, restart the backend, then re-activate your voice agent so
# the new URL is registered with Vapi. Repeat each session (URL changes on restart).
# For a stable URL across sessions use ngrok: `npx ngrok http 3001`.
BACKEND_URL=http://localhost:3001

# Vapi (voice agent runtime)
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

# Slack (Events API webhook for @mention replies)
# Bot User OAuth Token from OAuth & Permissions (Basic Information page has the
# Signing Secret). Set the Event Subscriptions Request URL to
# <BACKEND_URL>/api/slack/events — for local dev use
# `pnpm --filter @mirrorverse/backend dev:tunnel` or ngrok.
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=

# Vault — 64-char hex string (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_ENCRYPTION_KEY=

# Composio
COMPOSIO_API_KEY=
COMPOSIO_OAUTH_CALLBACK_URL=http://localhost:3001/api/connections/callback

# Inngest
# Set INNGEST_DEV=1 for local development; without it the serve endpoint
# returns 500 ("In cloud mode but no signing key found"). Leave the keys
# blank in dev — they're only needed in production.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_SIGNING_KEY_FALLBACK=

# Stripe
# Get your secret key from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret — obtained from the Stripe CLI during local dev:
#   stripe listen --forward-to localhost:3001/api/webhooks/stripe
# Copy the printed "whsec_..." value here and restart the backend.
# For production: create a webhook endpoint in Stripe Dashboard → Developers → Webhooks
# and copy the signing secret from there.
# Optional: if absent the webhook handler will parse events without signature verification
# (logs a warning). Never leave unset in production.
STRIPE_WEBHOOK_SECRET=whsec_...

# Langfuse (LLM observability)
# Create a project at https://cloud.langfuse.com and copy keys from Settings → API Keys.
# All three vars are optional; omit them in dev to disable tracing.
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_BASEURL=https://cloud.langfuse.com

# Email (Resend)
RESEND_API_KEY=re_...
# From address for transactional emails (OTP, billing alerts, workflow notifications)
RESEND_FROM_EMAIL=
# From address for lifecycle/marketing emails (welcome, digest, re-engagement)
RESEND_MARKETING_FROM_EMAIL=

# Supabase Auth Email Hook secret — from Supabase dashboard → Authentication → Hooks
# Configure the hook URL as: <BACKEND_URL>/api/auth/hook/send-email
SUPABASE_HOOK_SECRET=
# Optional: paste the JSON from {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# Required when Node.js cannot reach Supabase directly (e.g. firewall in dev).
SUPABASE_JWKS=

# CORS
CORS_ORIGIN=http://localhost:3000
