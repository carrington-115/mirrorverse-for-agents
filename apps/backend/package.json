{
  "name": "@mirrorverse/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Mirrorverse tRPC backend (Vercel serverless)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env.development src/dev.ts",
    "build": "tsc --noEmit",
    "start": "tsx --env-file=.env.development src/dev.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"api/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "dev:tunnel": "npx localtunnel --port 3001",
    "clean": "rm -rf .turbo dist node_modules coverage .vercel"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.63",
    "@anthropic-ai/claude-agent-sdk": "^0.3.142",
    "@composio/core": "^0.10.0",
    "@mirrorverse/agent": "workspace:*",
    "@mirrorverse/db": "workspace:*",
    "@mirrorverse/env": "workspace:*",
    "@mirrorverse/types": "workspace:*",
    "@mozilla/readability": "^0.6.0",
    "@sentry/node": "^9.0.0",
    "@trpc/server": "^11.15.0",
    "@vapi-ai/server-sdk": "^1.2.0",
    "ai": "^6.0.177",
    "inngest": "^4.4.0",
    "jsdom": "^29.1.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "superjson": "^2.2.2",
    "twilio": "^6.0.2",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@mirrorverse/eslint-config": "workspace:*",
    "@mirrorverse/typescript-config": "workspace:*",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.5.0",
    "@types/pdf-parse": "^1.1.5",
    "eslint": "^9.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
