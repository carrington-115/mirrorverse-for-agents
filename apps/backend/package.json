{
  "name": "@mirrorverse/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Mirrorverse tRPC backend (Next.js route handlers)",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "dev:node": "tsx watch --env-file=.env.development src/dev.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"api/**/*.ts\" \"app/**/*.ts\" \"proxy.ts\"",
    "typecheck": "tsc --noEmit",
    "dev:inngest": "npx inngest-cli@latest dev -u http://localhost:3001/api/inngest",
    "dev:tunnel": "npx localtunnel --port 3001",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf .turbo .next dist node_modules coverage .vercel"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.36",
    "@ai-sdk/openai": "^3.0.63",
    "@anthropic-ai/claude-agent-sdk": "^0.3.142",
    "@composio/core": "^0.10.0",
    "@e2b/code-interpreter": "^2.6.0",
    "@langfuse/otel": "^5.3.0",
    "@mirrorverse/agent": "workspace:*",
    "@mirrorverse/db": "workspace:*",
    "@mirrorverse/env": "workspace:*",
    "@mirrorverse/types": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.15.0",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@sentry/node": "^9.0.0",
    "@trpc/server": "^11.15.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.34.0",
    "@vapi-ai/server-sdk": "^1.2.0",
    "ai": "^6.0.177",
    "cheerio": "^1.2.0",
    "croner": "^10.0.1",
    "inngest": "^4.4.0",
    "mammoth": "^1.12.0",
    "next": "16.1.6",
    "pdf-parse": "^2.4.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^4.6.0",
    "stripe": "^22.1.1",
    "superjson": "^2.2.2",
    "twilio": "^6.0.2",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@mirrorverse/eslint-config": "workspace:*",
    "@mirrorverse/typescript-config": "workspace:*",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.5.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
