{
  "name": "@mirrorverse/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .turbo node_modules",
    "db:pull": "drizzle-kit pull",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:verify": "node scripts/verify.mjs",
    "db:sync-directory": "node scripts/sync-directory.mjs",
    "db:seed-plans": "node scripts/seed-plans.mjs",
    "db:setup-stripe-products": "node scripts/setup-stripe-products.mjs"
  },
  "dependencies": {
    "@mirrorverse/env": "workspace:*",
    "@mirrorverse/types": "workspace:*",
    "@supabase/supabase-js": "^2.45.4",
    "drizzle-orm": "^0.45.1",
    "jose": "^5.9.6",
    "postgres": "^3.4.8",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "@mirrorverse/eslint-config": "workspace:*",
    "@mirrorverse/typescript-config": "workspace:*",
    "@testcontainers/postgresql": "^10.13.2",
    "@types/node": "^25.5.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
